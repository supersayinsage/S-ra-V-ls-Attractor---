import random

def mutate_chain(chain, rate=0.2):
    ops = ["P", "G", "T", "R", "E", "O"]
    new_chain = ""

    for c in chain:
        if random.random() < rate:
            new_chain += random.choice(ops)
        else:
            new_chain += c

    return new_chain
def evolve_pooh_chain(chain, generations=10):
    current = chain
    for _ in range(generations):
        current = mutate_chain(current)
        print("Generation:", current)
import numpy as np

def book_to_field(stats, size=200):
    field = np.zeros((size, size))

    # Word frequency → horizontal gradient
    field += np.interp(np.linspace(0, 1, size), [0, 1], stats["word_freq_mean"])

    # Sentence length → vertical gradient
    field += np.interp(np.linspace(0, 1, size), [0, 1], stats["sentence_length_mean"]).reshape(-1, 1)

    # Emotional tone → diagonal
    diag = np.linspace(stats["tone_min"], stats["tone_max"], size)
    field += np.outer(diag, diag)

    # Normalize
    field = (field - field.min()) / (field.max() - field.min())
    return field
