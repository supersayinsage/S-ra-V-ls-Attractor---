def visualize_pooh_chain(chain, A, B):
    compiled = compile_chain(chain)
    states = []

    current = A.copy()

    for op in compiled:
        if op == "interact":
            current = interact(current, B)
        elif op == "interact_distort":
            current = distort(interact(current, B))
        elif op == "distort":
            current = distort(current)
        elif op == "entangle":
            current = entangle(current, B)
        elif op == "collapse":
            current.field = collapse(current)
        elif op == "entangle_collapse":
            current.field = collapse(entangle(current, B))

        states.append(current.field)

    plot_sequence(states)
